<Project Sdk="Microsoft.NET.Sdk">

  <!-- Casos de uso. Depende do Domain e do Data, NUNCA da API: o que vem de fora (Mercado Pago, criptografia, PDF)
       entra por interface (Application/Interfaces/Chacara) e é implementado na API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LojaApi.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Resend" Version="0.6.0" />
    <!-- O Resend 0.6.0 traz o WebUtilities 8.0.20, com vulnerabilidade alta (GHSA-x33c-w48q-qrgc). Fixar aqui a versão corrigida. -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\LojaApi.Domain.csproj" />
    <ProjectReference Include="..\Data\LojaApi.Data.csproj" />
  </ItemGroup>

</Project>
