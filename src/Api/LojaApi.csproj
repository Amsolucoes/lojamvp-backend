<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LojaApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="Resend" Version="0.6.0" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes (tests/LojaApi.Tests) enxergam os tipos internos da API -->
    <InternalsVisibleTo Include="LojaApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Camadas em projetos irmãos, cada um na sua pasta de src/ -->
    <ProjectReference Include="..\Domain\LojaApi.Domain.csproj" />
    <ProjectReference Include="..\Application\LojaApi.Application.csproj" />
    <ProjectReference Include="..\Data\LojaApi.Data.csproj" />
  </ItemGroup>

</Project>
