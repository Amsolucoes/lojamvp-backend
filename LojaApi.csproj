<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LojaApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="Resend" Version="0.6.0" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes ficam em tests/ com projeto próprio: não podem entrar na compilação da API -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <InternalsVisibleTo Include="LojaApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Camadas em projetos próprios (cada uma tem o seu .csproj dentro da pasta) -->
    <Compile Remove="src/Domain/**" />
    <None Remove="src/Domain/**" />
    <Content Remove="src/Domain/**" />
    <EmbeddedResource Remove="src/Domain/**" />
    <Compile Remove="src/Data/**" />
    <None Remove="src/Data/**" />
    <Content Remove="src/Data/**" />
    <EmbeddedResource Remove="src/Data/**" />
    <Compile Remove="src/Application/**" />
    <None Remove="src/Application/**" />
    <Content Remove="src/Application/**" />
    <EmbeddedResource Remove="src/Application/**" />
    <ProjectReference Include="src/Domain/LojaApi.Domain.csproj" />
    <ProjectReference Include="src/Application/LojaApi.Application.csproj" />
    <ProjectReference Include="src/Data/LojaApi.Data.csproj" />
  </ItemGroup>

</Project>
